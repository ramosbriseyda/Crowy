{
  "manifest_version": 3,
  "name": "Crowy",
  "version": "1.2",
  "description": "Analyze news on the current page with AI: reliability, sensationalism, and sources.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Verify news",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
