{
  "manifest_version": 3,
  "name": "Crowy",
  "version": "1.2",
  "description": "Analiza noticias en la página actual con IA: veracidad, amarillismo y fuentes.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Verificar noticia"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
